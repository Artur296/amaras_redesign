# Publishing: the admin panel commits content back to this repository, and
# the push is what makes Vercel redeploy. Without these the panel is
# read-only.
# Token: GitHub → Settings → Developer settings → Personal access tokens →
# Fine-grained tokens. Repository access: only this repo. Permissions:
# Contents = Read and write. Nothing else.
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=razGit2220/amaras-tours
# Branch the live site deploys from. Defaults to main.
GITHUB_BRANCH=main

# Admin login. Set exactly one of these two.
# Preferred — generate with: npm run hash-password "your password"
ADMIN_PASSWORD_HASH=
# Or the password in plain text. Weaker, but it means a forgotten password is
# fixed by editing this one variable in Vercel from a phone.
ADMIN_PASSWORD=
# Optional, defaults to "admin".
ADMIN_USERNAME=admin

# Optional. Sessions are signed with this; changing it signs everyone out.
# Left unset it is derived from the password, so a password change also
# invalidates old sessions.
ADMIN_SESSION_SECRET=
